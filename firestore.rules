rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        ((request.auth.token.email == 'aibrandorigin@gmail.com' || request.auth.token.email == 'brandorigin@gmail.com') && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidEnquiry(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 128
        && data.email is string && data.email.size() > 3 && data.email.size() <= 256
        && data.company is string && data.company.size() <= 128
        && data.stage is string && data.stage.size() <= 128
        && data.timeline is string && data.timeline.size() <= 128
        && data.budget is string && data.budget.size() <= 128
        && data.concept is string && data.concept.size() <= 4096
        && data.status in ['new', 'reviewing', 'contacted', 'closed'];
    }

    // Client brief enquiries
    match /enquiries/{enquiryId} {
      allow create: if isValidId(enquiryId) && isValidEnquiry(incoming());
      allow read, update, delete: if isAdmin();
    }

    // Live case studies / projects
    match /projects/{projectId} {
      allow read: if isValidId(projectId);
      allow write: if isValidId(projectId) && isAdmin();
    }

    // Services ecosystem
    match /services/{serviceId} {
      allow read: if isValidId(serviceId);
      allow write: if isValidId(serviceId) && isAdmin();
    }

    // Admin records
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Live website content synchronized across all browsers
    match /content/{contentId} {
      allow read: if isValidId(contentId);
      allow write: if isValidId(contentId) && isAdmin();
    }

    // Health connection probe
    match /test/{docId} {
      allow read: if true;
    }
  }
}
