{
  "entities": {
    "Enquiry": {
      "title": "Enquiry",
      "description": "Client brief initiation submission",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "company": { "type": "string", "maxLength": 128 },
        "stage": { "type": "string", "maxLength": 128 },
        "timeline": { "type": "string", "maxLength": 128 },
        "budget": { "type": "string", "maxLength": 128 },
        "concept": { "type": "string", "maxLength": 2048 },
        "status": { "type": "string", "enum": ["new", "reviewing", "contacted", "closed"] },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "email", "company", "stage", "timeline", "budget", "concept", "status"]
    },
    "Project": {
      "title": "Project",
      "description": "Case study showcase item",
      "type": "object",
      "properties": {
        "client": { "type": "string", "maxLength": 128 },
        "industry": { "type": "string", "maxLength": 128 },
        "year": { "type": "string", "maxLength": 32 },
        "image": { "type": "string" },
        "headline": { "type": "string", "maxLength": 256 },
        "stages": { "type": "object" },
        "metrics": { "type": "array" }
      },
      "required": ["client", "industry", "headline"]
    },
    "Service": {
      "title": "Service",
      "description": "Capability offering item",
      "type": "object",
      "properties": {
        "number": { "type": "string", "maxLength": 16 },
        "title": { "type": "string", "maxLength": 128 },
        "category": { "type": "string", "maxLength": 128 },
        "description": { "type": "string", "maxLength": 2048 },
        "deliverables": { "type": "array" },
        "impactMetric": { "type": "string", "maxLength": 128 }
      },
      "required": ["number", "title", "description"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Authorized administrator record",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 256 },
        "role": { "type": "string", "enum": ["admin"] },
        "createdAt": { "type": "string" }
      },
      "required": ["email", "role"]
    },
    "SiteContent": {
      "title": "SiteContent",
      "description": "Global website content configuration",
      "type": "object",
      "properties": {
        "header": { "type": "object" },
        "hero": { "type": "object" },
        "projects": { "type": "array" },
        "services": { "type": "array" },
        "careers": { "type": "array" },
        "careerApplications": { "type": "array" },
        "updatedAt": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/enquiries/{enquiryId}": {
      "schema": "Enquiry",
      "description": "Client enquiries submitted through the brief modal"
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Live case studies displayed on the work section"
    },
    "/services/{serviceId}": {
      "schema": "Service",
      "description": "Active services and capabilities"
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Authorized admins for CMS access"
    },
    "/content/{contentId}": {
      "schema": "SiteContent",
      "description": "Synchronized site content across all browser sessions"
    }
  }
}
